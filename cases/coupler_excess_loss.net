# Both outputs drop by the excess loss.

title 3 dB coupler with 0.3 dB excess loss
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 21

comp c coupler kappa=0.5 excess_db=0.3
port in c.1
port in2 c.2
port bar c.3
port cross c.4

expect passive
expect level bar 1.55 -3.31029996 1e-6
expect level cross 1.55 -3.31029996 1e-6
