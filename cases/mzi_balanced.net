# Equal arms: all the light crosses, at every wavelength.

title Balanced Mach-Zehnder
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 201

comp c1 coupler kappa=0.5
comp c2 coupler kappa=0.5
comp a waveguide length=100.0
comp b waveguide length=100.0
link c1.3 a.1
link c1.4 b.1
port in c1.1
port in2 c1.2
port bar c2.3
port cross c2.4
link a.2 c2.1
link b.2 c2.2

expect lossless
expect level cross 1.55 0 1e-9
expect below bar -200
expect extinction cross 0 1e-9
