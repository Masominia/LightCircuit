# The ring adds a sharp phase step to one arm, which the interferometer turns into an asymmetric line.

title Mach-Zehnder with a ring on one arm
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.54 1.56 16001

comp c1 coupler kappa=0.5
comp c2 coupler kappa=0.5
comp a waveguide length=100
comp b1 waveguide length=50
comp b2 waveguide length=50
comp r coupler kappa=0.1
comp w waveguide length=62.8318530718
link c1.3 a.1
link a.2 c2.1
link c1.4 b1.1
link b1.2 r.1
link r.3 b2.1
link b2.2 c2.2
link r.4 w.1
link w.2 r.2
port in c1.1
port in2 c1.2
port bar c2.3
port cross c2.4

expect lossless 1e-8
expect reciprocal 1e-8
expect deeper bar -20
expect max cross 0 0.01
