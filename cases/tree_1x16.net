# 4 levels of Y-branches: every output carries 1/16 of the power, -12.0412 dB.
# This is the feed network of an optical phased array with uniform illumination.

title 1x16 splitter tree
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 21

comp s1 splitter
comp s2 splitter
comp s3 splitter
comp s4 splitter
comp s5 splitter
comp s6 splitter
comp s7 splitter
comp s8 splitter
comp s9 splitter
comp s10 splitter
comp s11 splitter
comp s12 splitter
comp s13 splitter
comp s14 splitter
comp s15 splitter
link s1.2 s2.1
link s1.3 s3.1
link s2.2 s4.1
link s2.3 s5.1
link s3.2 s6.1
link s3.3 s7.1
link s4.2 s8.1
link s4.3 s9.1
link s5.2 s10.1
link s5.3 s11.1
link s6.2 s12.1
link s6.3 s13.1
link s7.2 s14.1
link s7.3 s15.1
port in s1.1
port out1 s8.2
port out2 s8.3
port out3 s9.2
port out4 s9.3
port out5 s10.2
port out6 s10.3
port out7 s11.2
port out8 s11.3
port out9 s12.2
port out10 s12.3
port out11 s13.2
port out12 s13.3
port out13 s14.2
port out14 s14.3
port out15 s15.2
port out16 s15.3

expect passive
expect uniform 1e-9
expect level out1 1.55 -12.04119983 1e-6
expect level out16 1.55 -12.04119983 1e-6
expect phase_step 1.55 0 1e-9
