# All paths have the same length: equal power and equal phase at every wavelength, the starting point for phase-shifter steering.

title Equal-path feed for a 16-element array
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.52 1.58 61

comp s1 splitter
comp s2 splitter
comp s3 splitter
comp s4 splitter
comp s5 splitter
comp s6 splitter
comp s7 splitter
comp s8 splitter
comp s9 splitter
comp s10 splitter
comp s11 splitter
comp s12 splitter
comp s13 splitter
comp s14 splitter
comp s15 splitter
comp t1 waveguide length=250
comp t2 waveguide length=250
comp t3 waveguide length=250
comp t4 waveguide length=250
comp t5 waveguide length=250
comp t6 waveguide length=250
comp t7 waveguide length=250
comp t8 waveguide length=250
comp t9 waveguide length=250
comp t10 waveguide length=250
comp t11 waveguide length=250
comp t12 waveguide length=250
comp t13 waveguide length=250
comp t14 waveguide length=250
comp t15 waveguide length=250
comp t16 waveguide length=250
link s1.2 s2.1
link s1.3 s3.1
link s2.2 s4.1
link s2.3 s5.1
link s3.2 s6.1
link s3.3 s7.1
link s4.2 s8.1
link s4.3 s9.1
link s5.2 s10.1
link s5.3 s11.1
link s6.2 s12.1
link s6.3 s13.1
link s7.2 s14.1
link s7.3 s15.1
link s8.2 t1.1
link s8.3 t2.1
link s9.2 t3.1
link s9.3 t4.1
link s10.2 t5.1
link s10.3 t6.1
link s11.2 t7.1
link s11.3 t8.1
link s12.2 t9.1
link s12.3 t10.1
link s13.2 t11.1
link s13.3 t12.1
link s14.2 t13.1
link s14.3 t14.1
link s15.2 t15.1
link s15.3 t16.1
port in s1.1
port out1 t1.2
port out2 t2.2
port out3 t3.2
port out4 t4.2
port out5 t5.2
port out6 t6.2
port out7 t7.2
port out8 t8.2
port out9 t9.2
port out10 t10.2
port out11 t11.2
port out12 t12.2
port out13 t13.2
port out14 t14.2
port out15 t15.2
