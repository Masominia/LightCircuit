# Drop peak k1^2 k2^2 a / (1 - t1 t2 a)^2 = -0.119 dB, through minimum -37.368 dB.
# Width at half contrast 0.3089 nm, Q = 5017, free spectral range 9.104 nm.

title Add-drop ring, radius 10 um, coupling 0.1 / 0.1
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=2
sweep 1.53 1.57 16001

comp c1 coupler kappa=0.1
comp c2 coupler kappa=0.1
comp w1 waveguide length=31.4159265359
comp w2 waveguide length=31.4159265359
link c1.4 w1.1
link w1.2 c2.4
link c2.2 w2.1
link w2.2 c1.2
port in c1.1
port through c1.3
port drop c2.1
port add c2.3

expect passive
expect reciprocal
expect below add -200
expect max drop -0.1186 0.03
expect min through -37.3682 0.1
expect fwhm drop peaks 0.308931 0.01
expect fsr drop peaks 9.10404 0.005
