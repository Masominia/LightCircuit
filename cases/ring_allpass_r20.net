# Circumference 125.664 um, free spectral range lambda^2 / (ng L) = 4.5520 nm.

title All-pass ring, radius 20 um
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=3
sweep 1.5 1.6 16001
feature 0.5

comp c coupler kappa=0.05
comp w waveguide length=125.6637061436
link c.4 w.1
link w.2 c.2
port in c.1
port through c.3

expect passive
expect reciprocal
expect fsr through dips 4.55202 0.005
