# Rings of 10 and 12 um on the same bus: two interleaved combs of dips.

title Two all-pass rings on one bus
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=5
sweep 1.53 1.57 16001
feature 1

comp c1 coupler kappa=0.05
comp w1 waveguide length=62.8318530718
comp bus waveguide length=40
comp c2 coupler kappa=0.05
comp w2 waveguide length=75.3982236862
link c1.4 w1.1
link w1.2 c1.2
link c1.3 bus.1
link bus.2 c2.1
link c2.4 w2.1
link w2.2 c2.2
port in c1.1
port through c2.3

expect passive
expect reciprocal
expect deeper through -2
