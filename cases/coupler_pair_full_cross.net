# Two half couplers in a row are one full coupler: everything crosses over.

title Two 3 dB couplers back to back
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 21

comp a coupler kappa=0.5
comp b coupler kappa=0.5
link a.3 b.1
link a.4 b.2
port in a.1
port in2 a.2
port bar b.3
port cross b.4

expect lossless
expect level cross 1.55 0 1e-9
expect below bar -200
