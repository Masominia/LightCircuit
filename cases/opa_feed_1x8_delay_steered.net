# Each output is 20 um longer than the previous one, so neighbours differ by beta dL = -136.675 degrees (mod 360) at 1.56 um.
# Changing the wavelength changes this step: the beam steers without any phase shifter.

title Delay-line feed for an 8-element array, read at 1.56 um
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.54 1.57 3001

comp s1 splitter
comp s2 splitter
comp s3 splitter
comp s4 splitter
comp s5 splitter
comp s6 splitter
comp s7 splitter
comp t1 waveguide length=100.0
comp t2 waveguide length=120.0
comp t3 waveguide length=140.0
comp t4 waveguide length=160.0
comp t5 waveguide length=180.0
comp t6 waveguide length=200.0
comp t7 waveguide length=220.0
comp t8 waveguide length=240.0
link s1.2 s2.1
link s1.3 s3.1
link s2.2 s4.1
link s2.3 s5.1
link s3.2 s6.1
link s3.3 s7.1
link s4.2 t1.1
link s4.3 t2.1
link s5.2 t3.1
link s5.3 t4.1
link s6.2 t5.1
link s6.3 t6.1
link s7.2 t7.1
link s7.3 t8.1
port in s1.1
port out1 t1.2
port out2 t2.2
port out3 t3.2
port out4 t4.2
port out5 t5.2
port out6 t6.2
port out7 t7.2
port out8 t8.2

expect passive
expect uniform 1e-9
expect phase_step 1.56 -136.6749 0.02
