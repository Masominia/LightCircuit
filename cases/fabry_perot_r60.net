# Mode spacing lambda^2 / (2 ng L) = 1.4301 nm, minimum transmission ((1 - R) / (1 + R))^2 = -12.04 dB.
# Finesse pi sqrt(R) / (1 - R) = 6.1.

title Fabry-Perot cavity, mirror reflectivity 60%
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.545 1.555 16001

comp m1 reflector reflectivity=0.6
comp w waveguide length=200
comp m2 reflector reflectivity=0.6
link m1.2 w.1
link w.2 m2.1
port in m1.1
port out m2.2

expect lossless 1e-8
expect fsr out peaks 1.43006 0.005
expect max out 0 0.01
expect min out -12.0412 0.05
expect fwhm out peaks 0.223030 0.01
