# A symmetric lossless ring drops everything on resonance.

title Add-drop ring without loss
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.53 1.57 16001

comp c1 coupler kappa=0.1
comp c2 coupler kappa=0.1
comp w1 waveguide length=31.4159265359
comp w2 waveguide length=31.4159265359
link c1.4 w1.1
link w1.2 c2.4
link c2.2 w2.1
link w2.2 c1.2
port in c1.1
port through c1.3
port drop c2.1
port add c2.3

expect lossless 1e-8
expect max drop 0 0.01
expect deeper through -40
expect fsr drop peaks 9.10404 0.005
