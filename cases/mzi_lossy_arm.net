# Unequal arm amplitudes limit the extinction: maximum (1 + a)^2 / 4, minimum (1 - a)^2 / 4 with a = 0.708.

title Mach-Zehnder with 3 dB of loss in one arm
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 8001

comp c1 coupler kappa=0.5
comp c2 coupler kappa=0.5
comp a waveguide length=100.0
comp b waveguide length=200.0
comp x attenuator db=3
link c1.3 a.1
link c1.4 b.1
port in c1.1
port in2 c1.2
port bar c2.3
port cross c2.4
link a.2 x.1
link x.2 c2.1
link b.2 c2.2

expect passive
expect max cross -1.37112 1e-3
expect min cross -16.71133 1e-2
expect extinction bar 15.3402 0.02
