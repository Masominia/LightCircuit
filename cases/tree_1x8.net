# 3 levels of Y-branches: every output carries 1/8 of the power, -9.0309 dB.
# This is the feed network of an optical phased array with uniform illumination.

title 1x8 splitter tree
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=0
sweep 1.5 1.6 21

comp s1 splitter
comp s2 splitter
comp s3 splitter
comp s4 splitter
comp s5 splitter
comp s6 splitter
comp s7 splitter
link s1.2 s2.1
link s1.3 s3.1
link s2.2 s4.1
link s2.3 s5.1
link s3.2 s6.1
link s3.3 s7.1
port in s1.1
port out1 s4.2
port out2 s4.3
port out3 s5.2
port out4 s5.3
port out5 s6.2
port out6 s6.3
port out7 s7.2
port out8 s7.3

expect passive
expect uniform 1e-9
expect level out1 1.55 -9.03089987 1e-6
expect level out8 1.55 -9.03089987 1e-6
expect phase_step 1.55 0 1e-9
