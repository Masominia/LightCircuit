# Round-trip amplitude a = 0.99279, coupler transmission t = 0.95594.
# On resonance the transmission is ((t - a) / (1 - t a))^2 = -2.814 dB.

title All-pass ring, over-coupled
medium lambda0=1.55 neff=2.4 ng=4.2 loss_db_cm=5
sweep 1.54 1.56 16001
feature 1

comp c coupler kappa=0.0861804986
comp w waveguide length=125.6637061436
link c.4 w.1
link w.2 c.2
port in c.1
port through c.3

expect passive
expect min through -2.8135 0.05
expect fsr through dips 4.55202 0.005
